import { beforeEach, describe, expect, it, vi } from 'vitest';
import { I{{pascalCase name}}Repository } from '@/modules/{{dashCase name}}/application/repositories';
import { Delete{{pascalCase name}}UseCase } from '@/modules/{{dashCase name}}/application/use-cases';
import { InvalidInputException } from '@/shared/exceptions';

describe('Delete{{pascalCase name}}UseCase', () => {
  let sut: Delete{{pascalCase name}}UseCase;
  let repository: I{{pascalCase name}}Repository;

  beforeEach(() => {
