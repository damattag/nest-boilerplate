import { INestApplication } from '@nestjs/common';
import { Test } from '@nestjs/testing';
import request from 'supertest';
import { {{pascalCase name}}Factory, UserFactory } from 'tests/factories';
import { buildAppConfig } from 'tests/utils/build-app';
import { AppModule } from '@/app.module';
import { ITokenService } from '@/modules/auth/application/services';
import { DatabaseModule, PrismaService } from '@/shared/database';

describe('Create {{pascalCase name}} (e2e)', () => {
  let app: INestApplication;
  let {{camelCase name}}Factory: {{pascalCase name}}Factory;
  let userFactory: UserFactory;
  let tokenService: ITokenService;
  let prisma: PrismaService;

  beforeAll(async () => {
    const moduleRef = await Test.createTestingModule({
      imports: [AppModule, DatabaseModule],
      providers: [{{pascalCase name}}Factory, UserFactory],
    }).compile();

    app = moduleRef.createNestApplication();
    {{camelCase name}}Factory = moduleRef.get({{pascalCase name}}Factory);
    userFactory = moduleRef.get(UserFactory);
    tokenService = moduleRef.get(ITokenService);
    prisma = moduleRef.get(PrismaService);

    buildAppConfig(app);

    await app.init();
  });

  test('[POST] /v1/{{dashCase name}}', async () => {
    const user = await userFactory.makePrismaUser();
    const accessToken = await tokenService.generateAccessToken(user.id);

    const response = await request(app.getHttpServer())
      .post('/v1/{{dashCase name}}')
      .set('Authorization', `Bearer ${accessToken}`)
      .send({
        // TODO: add required fields
      });

    expect(response.status).toBe(201);

    const {{camelCase name}}OnDatabase = await prisma.{{camelCase name}}.findFirst();

    expect({{camelCase name}}OnDatabase).toBeTruthy();
  });
});
