{
  "name": "nestjs_boilerplate",
  "version": "0.0.1",
  "description": "NestJS Boilerplate",
  "author": "damattag",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "cross-env DATABASE_URL=postgresql://docker:docker@localhost:5432/nest_boilerplate nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "biome lint --diagnostic-level=warn --files-ignore-unknown=true ./src",
    "lint:fix": "biome lint --fix --files-ignore-unknown=true ./src && biome format --write ./src && biome check --fix ./src",
    "lint:ci": "biome ci --files-ignore-unknown=true ./src",
    "test": "vitest run",
    "test:watch": "vitest run --watch",
    "test:coverage": "vitest run --coverage",
    "types:check": "tsc --noEmit",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "gen": "plop module"
  },
  "dependencies": {
    "@faker-js/faker": "10.2.0",
    "@nestjs/common": "11.1.14",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.1.14",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.14",
    "@nestjs/swagger": "11.2.6",
    "@prisma/adapter-pg": "7.4.1",
    "@prisma/client": "7.4.1",
    "@sendgrid/mail": "8.1.6",
    "@swc/cli": "0.7.9",
    "@swc/core": "1.15.13",
    "bcryptjs": "3.0.3",
    "dotenv": "17.3.1",
    "passport-jwt": "4.0.1",
    "pg": "8.18.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "winston": "3.19.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.14",
    "@types/express": "5.0.6",
    "@types/node": "25.3.0",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.16.0",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.0.18",
    "cross-env": "10.1.0",
    "globals": "17.3.0",
    "plop": "4.0.5",
    "prisma": "7.4.1",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.9",
    "vite-tsconfig-paths": "6.0.3",
    "vitest": "4.0.18"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.11.4"
    }
  }
}
